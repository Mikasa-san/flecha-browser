+// A native context menu for the shell (showMenu). Owns its menu models, and
+// deletes itself once the menu has closed and the caller has its answer.
+class FlechaShellMenu : public ui::SimpleMenuModel::Delegate {
+ public:
+  struct Item {
+    std::u16string label;
+    int parent = -1;
+    bool enabled = true;
+    std::optional<bool> checked;
+    bool separator = false;
+  };
+  using Done = base::OnceCallback<void(std::optional<int>)>;
+
+  // Command ids are item indices plus one: Chromium keeps 0 for "none".
+  static constexpr int kFirstCommand = 1;
+
+  FlechaShellMenu(std::vector<Item> items, Done done)
+      : items_(std::move(items)),
+        done_(std::move(done)),
+        root_(std::make_unique<ui::SimpleMenuModel>(this)) {
+    std::set<int> submenus;
+    for (const Item& item : items_) {
+      if (item.parent >= 0) {
+        submenus.insert(item.parent);
+      }
+    }
+    std::vector<ui::SimpleMenuModel*> models(items_.size(), nullptr);
+    for (size_t i = 0; i < items_.size(); ++i) {
+      const Item& item = items_[i];
+      ui::SimpleMenuModel* model =
+          item.parent >= 0 ? models[item.parent] : root_.get();
+      if (!model) {
+        continue;  // Its parent was a separator.
+      }
+      const int command = static_cast<int>(i) + kFirstCommand;
+      if (item.separator) {
+        model->AddSeparator(ui::NORMAL_SEPARATOR);
+      } else if (submenus.contains(static_cast<int>(i))) {
+        submenus_.push_back(std::make_unique<ui::SimpleMenuModel>(this));
+        models[i] = submenus_.back().get();
+        model->AddSubMenu(command, item.label, models[i]);
+      } else if (item.checked.has_value()) {
+        model->AddCheckItem(command, item.label);
+      } else {
+        model->AddItem(command, item.label);
+      }
+    }
+  }
+  FlechaShellMenu(const FlechaShellMenu&) = delete;
+  FlechaShellMenu& operator=(const FlechaShellMenu&) = delete;
+  ~FlechaShellMenu() override = default;
+
+  // Shows the menu at `point` (screen coordinates). On macOS this runs the
+  // NSMenu's own event loop and returns once it has closed.
+  void Show(views::Widget* parent, const gfx::Point& point) {
+    runner_ = std::make_unique<views::MenuRunner>(
+        root_.get(), views::MenuRunner::CONTEXT_MENU,
+        base::BindRepeating(&FlechaShellMenu::OnClosed,
+                            weak_factory_.GetWeakPtr()));
+    runner_->RunMenuAt(parent, /*button_controller=*/nullptr,
+                       gfx::Rect(point, gfx::Size()),
+                       views::MenuAnchorPosition::kTopLeft,
+                       ui::mojom::MenuSourceType::kMouse);
+  }
+
+  // Answers without a pick and goes away (no window to show the menu in).
+  void Cancel() { Finish(); }
+
+  // ui::SimpleMenuModel::Delegate:
+  bool IsCommandIdChecked(int command_id) const override {
+    const Item* item = ItemFor(command_id);
+    return item && item->checked.value_or(false);
+  }
+  bool IsCommandIdEnabled(int command_id) const override {
+    const Item* item = ItemFor(command_id);
+    return item && item->enabled;
+  }
+  void ExecuteCommand(int command_id, int event_flags) override {
+    if (ItemFor(command_id)) {
+      picked_ = command_id - kFirstCommand;
+    }
+  }
+
+ private:
+  const Item* ItemFor(int command_id) const {
+    const int index = command_id - kFirstCommand;
+    if (index < 0 || static_cast<size_t>(index) >= items_.size()) {
+      return nullptr;
+    }
+    return &items_[index];
+  }
+
+  // The pick may come in after the menu says it closed; answer a task later,
+  // and never from inside the runner that is calling us.
+  void OnClosed() {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&FlechaShellMenu::Finish,
+                                  weak_factory_.GetWeakPtr()));
+  }
+
+  void Finish() {
+    if (done_) {
+      std::move(done_).Run(picked_);
+    }
+    delete this;
+  }
+
+  const std::vector<Item> items_;
+  Done done_;
+  std::unique_ptr<ui::SimpleMenuModel> root_;
+  std::vector<std::unique_ptr<ui::SimpleMenuModel>> submenus_;
+  std::unique_ptr<views::MenuRunner> runner_;
+  std::optional<int> picked_;
+  base::WeakPtrFactory<FlechaShellMenu> weak_factory_{this};
+};
+
+}  // namespace
+
+ExtensionFunction::ResponseAction FlechaPrivateShowMenuFunction::Run() {
+  auto params = flecha_private::ShowMenu::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+  content::WebContents* contents = GetSenderWebContents();
+  if (!contents) {
+    return RespondNow(Error("No page to show the menu in."));
+  }
+  std::vector<FlechaShellMenu::Item> items;
+  for (size_t i = 0; i < params->items.size(); ++i) {
+    const flecha_private::MenuItem& row = params->items[i];
+    FlechaShellMenu::Item item;
+    item.label = base::UTF8ToUTF16(row.label.value_or(std::string()));
+    item.parent = row.parent.value_or(-1);
+    // A submenu comes before its items.
+    if (item.parent < -1 || item.parent >= static_cast<int>(i)) {
+      return RespondNow(Error("Item * has a parent after it.",
+                              base::NumberToString(i)));
+    }
+    item.enabled = row.enabled.value_or(true);
+    item.checked = row.checked;
+    item.separator = row.separator.value_or(false);
+    items.push_back(std::move(item));
+  }
+  if (items.empty()) {
+    return RespondNow(NoArguments());
+  }
+
+  const gfx::Point point = contents->GetContainerBounds().origin() +
+                           gfx::Vector2d(params->x, params->y);
+  auto* menu = new FlechaShellMenu(
+      std::move(items),
+      base::BindOnce(
+          [](scoped_refptr<FlechaPrivateShowMenuFunction> function,
+             std::optional<int> picked) {
+            function->Respond(picked ? function->WithArguments(*picked)
+                                     : function->NoArguments());
+          },
+          scoped_refptr<FlechaPrivateShowMenuFunction>(this)));
+  // Shown a task later: on macOS the menu runs its own event loop, which
+  // shouldn't sit inside this call.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(
+          [](base::WeakPtr<content::WebContents> contents,
+             FlechaShellMenu* menu, gfx::Point point) {
+            views::Widget* parent =
+                contents ? views::Widget::GetTopLevelWidgetForNativeView(
+                               contents->GetNativeView())
+                         : nullptr;
+            if (!parent) {
+              menu->Cancel();
+              return;
+            }
+            menu->Show(parent, point);
+          },
+          contents->GetWeakPtr(), base::Unretained(menu), point));
+  return RespondLater();
+}
