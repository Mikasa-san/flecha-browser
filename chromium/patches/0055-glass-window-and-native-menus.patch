+namespace {
+
+// The window's glass, found again by this identifier
+// (BrowserFrameViewMac::OnPaint looks for it too).
+NSString* const kFlechaGlassIdentifier = @"FlechaGlass";
+
+NSVisualEffectView* FlechaGlassView(NSWindow* window) {
+  for (NSView* view in window.contentView.superview.subviews) {
+    if ([view.identifier isEqualToString:kFlechaGlassIdentifier] &&
+        [view isKindOfClass:[NSVisualEffectView class]]) {
+      return static_cast<NSVisualEffectView*>(view);
+    }
+  }
+  return nil;
+}
+
+}  // namespace
+
+void SetFlechaWindowGlass(views::Widget* widget, bool glass) {
+  if (!widget) {
+    return;
+  }
+  NSWindow* window = widget->GetNativeWindow().GetNativeNSWindow();
+  if (![window isKindOfClass:[BrowserNativeWidgetWindow class]]) {
+    return;
+  }
+  NSVisualEffectView* effect = FlechaGlassView(window);
+  if (glass == (effect != nil)) {
+    return;
+  }
+  auto* host = views::NativeWidgetMacNSWindowHost::GetFromNativeWindow(
+      widget->GetNativeWindow());
+  if (glass) {
+    // Under the content view, in the window's frame view: the material the
+    // sidebar of a Finder window has, blending what is behind the window.
+    NSView* content = window.contentView;
+    effect = [[NSVisualEffectView alloc] initWithFrame:content.superview.bounds];
+    effect.identifier = kFlechaGlassIdentifier;
+    effect.material = NSVisualEffectMaterialSidebar;
+    effect.blendingMode = NSVisualEffectBlendingModeBehindWindow;
+    // Glass whether or not the window is key, as the frame page asked.
+    effect.state = NSVisualEffectStateActive;
+    effect.autoresizingMask = NSViewWidthSizable | NSViewHeightSizable;
+    [content.superview addSubview:effect
+                       positioned:NSWindowBelow
+                       relativeTo:content];
+    window.opaque = NO;
+    // Not clearColor: a fully clear background keeps AppKit redrawing the
+    // window (as native_widget_ns_window_bridge.mm notes).
+    window.backgroundColor =
+        [NSColor.windowBackgroundColor colorWithAlphaComponent:0.001];
+    if (host) {
+      host->SetLayerAndCompositorOpaque(false);
+    }
+  } else {
+    [effect removeFromSuperview];
+    window.opaque = YES;
+    window.backgroundColor = NSColor.windowBackgroundColor;
+    if (host) {
+      host->SetLayerAndCompositorOpaque(true);
+    }
+  }
+  [window invalidateShadow];
+  // The frame view stops (or starts again) painting its opaque colour.
+  if (views::NonClientView* non_client = widget->non_client_view()) {
+    if (views::View* frame_view = non_client->frame_view()) {
+      frame_view->SchedulePaint();
+    }
+  }
+}
 
